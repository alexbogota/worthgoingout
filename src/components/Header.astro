---
const path = Astro.url.pathname;
const links = [
  { href: '/eclipse-2027/', label: 'Eclipse 2027' },
  { href: '/meteor-showers/', label: 'Meteor showers' },
  { href: '/aurora/', label: 'Northern lights' },
  { href: '/stargazing/', label: 'Stargazing' },
  { href: '/guides/', label: 'Guides' },
  { href: '/about/', label: 'About' },
];
const active = (href: string) => (path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined);
---
<header>
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Worth Going Out, home">
      <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="9" fill="var(--gold)"></circle><circle cx="17.5" cy="15" r="9" fill="var(--bg)"></circle><circle cx="15" cy="15" r="13" fill="none" stroke="var(--gold)" stroke-width="1.5" stroke-dasharray="2 3.2"></circle></svg>
      <span>Worth Going Out</span>
    </a>
    <nav aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={active(l.href)}>{l.label}</a>)}
    </nav>
    <button type="button" class="theme" id="theme-toggle" aria-label="Switch to light theme">
      <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moonicon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </div>
</header>

<script>
  const button = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const label = () => button?.setAttribute('aria-label', root.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
  label();
  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#f4f5fc' : '#0f1230');
    try { localStorage.setItem('wgo-theme', next); } catch {}
    label();
  });
</script>

<style>
  header { border-bottom: 1px solid var(--line); background: var(--bg); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 32px; padding-top: 6px; padding-bottom: 6px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; text-decoration: none; }
  .logo span { font-family: var(--font-head); font-size: 1.3rem; color: var(--heading); letter-spacing: -0.01em; }
  nav { display: flex; flex-wrap: wrap; gap: 0 26px; }
  nav a { display: inline-flex; align-items: center; min-height: 48px; text-decoration: none; color: var(--muted); font-weight: 700; font-size: 1rem; }
  nav a:hover { color: var(--heading); }
  nav a[aria-current='page'] { color: var(--heading); box-shadow: inset 0 -3px 0 var(--gold); }
  .theme { margin-left: auto; display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; padding: 0; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); color: var(--muted); cursor: pointer; }
  .theme:hover { color: var(--heading); }
  .moonicon { display: none; }
  :global(:root[data-theme='light']) .sun { display: none; }
  :global(:root[data-theme='light']) .moonicon { display: block; }
  @media (max-width: 720px) {
    .logo { order: 1; } .theme { order: 2; }
    nav { order: 3; flex-basis: 100%; flex-wrap: nowrap; gap: 0 20px; overflow-x: auto; scrollbar-width: none; margin: 0 -24px; padding: 0 24px; }
    nav::-webkit-scrollbar { display: none; }
    nav a { white-space: nowrap; min-height: 44px; }
  }
</style>
