---
// Email sign-up. Posts to /api/subscribe.php (PHP on our hosting), which stores the address in a private GitHub repository.
// Works without JavaScript (redirects to /thanks/); with JavaScript it shows the result in place.
interface Props { topic?: 'eclipses' | 'meteors' | 'aurora' | 'stargazing' }
const { topic } = Astro.props;
const topics = [
  ['eclipses', 'Eclipses'],
  ['meteors', 'Meteor showers'],
  ['aurora', 'Northern lights'],
  ['stargazing', 'Stargazing'],
];
const uid = `su-${Math.random().toString(36).slice(2, 8)}`;
---
<section class="signup" aria-labelledby={`${uid}-h`}>
  <h2 id={`${uid}-h`}>Get a note when it is worth going out</h2>
  <p class="measure">A short email before an eclipse, a strong meteor shower or a dark week worth planning for. No more than a few a month.</p>
  <form class="su-form" method="post" action="/api/subscribe.php" novalidate>
    <div class="row">
      <label for={`${uid}-e`}>Your email</label>
      <div class="field">
        <input id={`${uid}-e`} type="email" name="email" required autocomplete="email" inputmode="email" placeholder="you@example.com" />
        <button class="btn" type="submit">Sign me up</button>
      </div>
    </div>
    <fieldset>
      <legend>What would you like to hear about?</legend>
      {topics.map(([v, l]) => <label class="chk"><input type="checkbox" name="topics[]" value={v} checked={!topic || topic === v} /> {l}</label>)}
    </fieldset>
    <label class="chk consent"><input type="checkbox" name="consent" value="yes" required /> Email me about these. I can unsubscribe at any time.</label>
    <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
    <input type="hidden" name="t" value="0" />
    <input type="hidden" name="page" value={Astro.url.pathname} />
    <p class="fine">We keep your address in a private list and use it only for these emails. <a href="/privacy/#emails">How we handle it</a>.</p>
    <p class="msg" role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('.su-form')) {
    const t = form.querySelector<HTMLInputElement>('input[name="t"]');
    if (t) t.value = String(Date.now());
    const msg = form.querySelector<HTMLElement>('.msg');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = form.querySelector<HTMLInputElement>('input[type="email"]');
      const consent = form.querySelector<HTMLInputElement>('input[name="consent"]');
      if (!email?.value || !email.checkValidity()) { msg!.textContent = 'Please enter a valid email address.'; msg!.className = 'msg bad'; email?.focus(); return; }
      if (!consent?.checked) { msg!.textContent = 'Please tick the box to agree to receive our emails.'; msg!.className = 'msg bad'; consent?.focus(); return; }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      button!.disabled = true; msg!.textContent = 'Signing you up…'; msg!.className = 'msg';
      try {
        const r = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const j = await r.json();
        msg!.textContent = j.message; msg!.className = j.ok ? 'msg good' : 'msg bad';
        if (j.ok) form.reset();
      } catch {
        msg!.textContent = 'Could not reach the server. Please try again in a moment.'; msg!.className = 'msg bad';
      }
      button!.disabled = false;
    });
  }
</script>

<style>
  .signup { border-top: 2px solid var(--line); border-bottom: 2px solid var(--line); padding: 32px 0 20px; margin: 3rem 0 1rem; }
  .signup h2 { margin: 0 0 0.6rem; }
  .row label { display: block; font-weight: 700; color: var(--heading); margin-bottom: 6px; }
  .field { display: flex; flex-wrap: wrap; gap: 10px; max-width: 560px; }
  .field input { flex: 1 1 240px; min-height: 48px; padding: 10px 14px; font: inherit; color: var(--text); background: var(--panel); border: 1px solid var(--line); border-radius: 6px; }
  .field input:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  fieldset { border: 0; padding: 0; margin: 16px 0 6px; display: flex; flex-wrap: wrap; gap: 4px 20px; }
  legend { font-weight: 700; color: var(--heading); margin-bottom: 4px; padding: 0; }
  .chk { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; cursor: pointer; }
  .chk input { width: 20px; height: 20px; accent-color: var(--gold); }
  .consent { margin-top: 4px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .fine { font-size: 0.875rem; color: var(--muted); margin: 8px 0 0; }
  .fine a { color: inherit; }
  .msg { min-height: 1.5em; margin: 8px 0 0; font-weight: 700; }
  .msg.good { color: var(--go); } .msg.bad { color: var(--skip); }
</style>
