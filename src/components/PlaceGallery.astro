---
// Two or three photos of a place (data/photos.json), shown as a pair: one larger, one smaller. Every photo keeps its caption and credit.
// A very wide photo (panorama) takes the full width on its own row. Optional "focus" in photos.json sets the crop centre.
import photos from '../../data/photos.json';
interface Props { ids: string[] }
const { ids } = Astro.props;
const items = ids.map((id) => {
  const p = (photos.photos as Record<string, any>)[id];
  if (!p) throw new Error(`Unknown photo: ${id}`);
  return { id, p, pano: p.width / p.height > 2.4 };
});
// Three ordinary photos: the first one leads, wide, above the other two.
const lead = items.length === 3 && items.every((i) => !i.pano) ? items[0].id : null;
---
{items.length > 0 && (
  <div class="gallery">
    {items.map(({ id, p, pano }) => (
      <figure class:list={{ pano, lead: id === lead }}>
        <img
          src={`/photos/${id}-1600.webp`}
          srcset={`/photos/${id}-800.webp 800w, /photos/${id}-1600.webp 1600w`}
          sizes={pano ? '(max-width: 1168px) 100vw, 1120px' : '(max-width: 760px) 100vw, 560px'}
          width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async"
          style={!pano && p.focus ? `object-position: ${p.focus}` : undefined}
        />
        <figcaption>
          {p.caption}. <span class="credit">Photo: <a href={p.page}>{p.author || 'Unknown author'}</a>, {p.licenseUrl ? <a href={p.licenseUrl}>{p.license}</a> : p.license}, via Wikimedia Commons.</span>
        </figcaption>
      </figure>
    ))}
  </div>
)}
<style>
  .gallery { display: grid; grid-template-columns: 1fr; gap: 22px; margin: 2.2rem 0; }
  figure { margin: 0; min-width: 0; }
  img { display: block; width: 100%; height: auto; border-radius: 6px; background: var(--raise); }
  figure:not(.pano) img { aspect-ratio: 4 / 3; object-fit: cover; }
  figure.lead img { aspect-ratio: 16 / 9; }
  figcaption { margin-top: 8px; font-size: 0.9375rem; color: var(--muted); line-height: 1.5; }
  .credit { font-size: 0.8125rem; }
  figcaption a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  @media (min-width: 760px) {
    .gallery { grid-template-columns: 3fr 2fr; align-items: start; max-width: 960px; }
    figure.pano, figure.lead { grid-column: 1 / -1; }
  }
</style>
